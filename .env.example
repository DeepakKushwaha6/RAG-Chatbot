# --- LLM provider -------------------------------------------------------
# "auto" tries, in order: MiniMax platform key -> OpenRouter -> MiniMax
# runtime session token -> OpenAI-compatible key -> Ollama (local) ->
# extractive fallback.
# "none" disables the LLM entirely: answers quote the original passages
# verbatim. Use this for a public deployment where nobody should be able to
# spend your API key.
RAG_LLM_PROVIDER=auto

# --- OpenRouter (recommended for a public deployment) --------------------
# The app asks OpenRouter which models are free right now and uses the best
# one, re-checking periodically so it follows the free lineup as it changes.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Leave empty to always use the auto-selected best free model.
OPENROUTER_MODEL=
# How often to re-check for a better free model (seconds).
OPENROUTER_REFRESH_SECONDS=1800
# Optional attribution headers OpenRouter shows in its dashboard.
OPENROUTER_REFERER=
OPENROUTER_TITLE=DocuMind RAG Chatbot

# MiniMax platform API key (https://platform.minimaxi.com). Used as x-api-key.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Any OpenAI-compatible provider (OpenAI, Groq, Together, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama server (no key needed when running locally).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Retrieval tuning ---------------------------------------------------
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=16000
RAG_MIN_SCORE=0.12

# --- Server -------------------------------------------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000

# Where uploads and the index are written. The container sets this to /data;
# Hugging Face Spaces can persist /data across restarts.
RAG_DATA_DIR=

# Port to listen on. Set by the platform (Hugging Face Spaces: 7860,
# Render: 10000). Leave empty locally.
PORT=
