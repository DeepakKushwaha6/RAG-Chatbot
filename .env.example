# --- LLM provider -------------------------------------------------------
# "auto" tries, in order: MiniMax platform key -> MiniMax runtime session
# token -> OpenAI-compatible key -> Ollama (local) -> extractive fallback.
RAG_LLM_PROVIDER=auto

# MiniMax platform API key (https://platform.minimaxi.com). Used as x-api-key.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Any OpenAI-compatible provider (OpenAI, Groq, Together, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama server (no key needed when running locally).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Retrieval tuning ---------------------------------------------------
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=16000
RAG_MIN_SCORE=0.12

# --- Server -------------------------------------------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000
